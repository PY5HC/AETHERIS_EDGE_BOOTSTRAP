{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheris.invalid/schemas/node-agent-release-manifest-1.0.json",
  "title": "AETHERIS Node Agent release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "repository", "source_commit", "build_timestamp_utc", "architecture", "python_version", "package", "artifact", "dependencies", "entrypoint", "runtime", "health", "activation", "governance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repository": {"const": "PY5HC/AETHERIS_NODE_AGENT"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "build_timestamp_utc": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "architecture": {"const": "aarch64"},
    "python_version": {"type": "string", "pattern": "^3\\.(1[1-9]|[2-9][0-9])(?:\\.[0-9]+)?$"},
    "package": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "aetheris-node-agent"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "release_root"], "properties": {"kind": {"enum": ["wheel", "source-venv", "binary"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "release_root": {"const": "/opt/aetheris/releases"}}},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["provenance", "lock_reference"], "properties": {"provenance": {"type": "string", "minLength": 1}, "lock_reference": {"type": "string", "minLength": 1}}},
    "entrypoint": {"type": "object", "additionalProperties": false, "required": ["relative_path", "runner_kind"], "properties": {"relative_path": {"type": "string", "pattern": "^(?:bin|venv/bin)/[A-Za-z0-9._/-]+$"}, "runner_kind": {"enum": ["project-runner", "console-script", "python-module"]}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["model", "python_executable"], "properties": {"model": {"const": "release-venv"}, "python_executable": {"const": "venv/bin/python"}}},
    "health": {"type": "object", "additionalProperties": false, "required": ["liveness_path", "readiness_path"], "properties": {"liveness_path": {"type": "string", "pattern": "^/[^ ]*$"}, "readiness_path": {"type": "string", "pattern": "^/[^ ]*$"}}},
    "activation": {"type": "object", "additionalProperties": false, "required": ["requires_hash_verification", "requires_readiness_probe", "rollback_release_required"], "properties": {"requires_hash_verification": {"const": true}, "requires_readiness_probe": {"const": true}, "rollback_release_required": {"const": true}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["repository", "revision", "governance_version", "profile", "contract_version"], "properties": {"repository": {"const": "PY5HC/AETHERIS_GOVERNANCE"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "governance_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "profile": {"const": "NOT_YET_ESTABLISHED"}, "contract_version": {"type": "string", "minLength": 1}}}
  }
}
